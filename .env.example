# =========================================================
# dnhy-space 环境变量模板（复制为 .env 后填写）
# =========================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=DnhySpace
# 宿主机端口
POSTGRES_PORT=5433

# ---------- ABP 后端 ----------
ASPNETCORE_ENVIRONMENT=Development
# 开发环境 HTTP 端口 / HTTPS 端口
API_HTTP_PORT=44300
API_HTTPS_PORT=44301
# 管理员初始账号（DbMigrator 首次运行写入）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_123456
ADMIN_EMAIL=admin@dnhy-space.local
# 访客令牌签名密钥（前后端必须一致，至少 32 字符）
VISITOR_JWT_SECRET=please-change-this-visitor-jwt-secret-32chars
# 允许跨域访问的后台地址（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5666

# =========================================================
# docker compose 使用以下变量（docker compose --env-file .env up -d）
# =========================================================
# 宿主机映射端口
API_PORT=8080
WEB_PORT=3000
ADMIN_PORT=8081
# 对外访问地址（部署到域名时改成 https://...）
API_PUBLIC_URL=http://localhost:8080
WEB_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:8081
TZ=Asia/Shanghai

# ---------- Next.js 前台 ----------
# 服务端访问 ABP 的地址（容器内为 http://api:8080）
ABP_API_BASE_URL=http://localhost:44300
NEXT_PUBLIC_SITE_NAME=dnhy-space
AUTH_URL=http://localhost:3000
AUTH_SECRET=please-change-this-auth-secret
# GitHub OAuth App（留空则隐藏登录入口）
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ---------- Vben 后台 ----------
# 开发环境走 vite 代理，生产环境由 nginx 同源反代
VITE_GLOB_API_URL=/api-proxy
